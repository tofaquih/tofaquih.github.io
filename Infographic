                callbacks: {
                    title: tooltipTitleCallback,
                    label: function(context) {
                        const v = context.raw;
                        return `Years: ${v[0]} - ${v[1]}`;
                    }
                }
            }
        },
        scales: {
            x: {
                min: 0,
                max: 5,
                ticks: {
                    stepSize: 1,
                    callback: function(value) {
                        if (value === 0) return 'Start';
                        return 'Year ' + value;
                    }
                },
                title: {
                    display: true,
                    text: 'Project Timeline'
                }
            },
            y: {
                 ticks: { color: '#4b5563', font: { family: "'Inter', sans-serif", size: 10 } },
            }
        }
    };


    window.addEventListener('load', () => {
        const diseaseBurdenCtx = document.getElementById('diseaseBurdenChart');
        if (diseaseBurdenCtx) {
            new Chart(diseaseBurdenCtx, { type: 'bar', data: diseaseData, options: diseaseOptions });
        }

        const lifecourseCtx = document.getElementById('lifecourseChart');
        if (lifecourseCtx) {
            new Chart(lifecourseCtx, { type: 'line', data: lifecourseData, options: lifecourseOptions });
        }
        
        const ganttCtx = document.getElementById('ganttChart');
        if (ganttCtx) {
            new Chart(ganttCtx, { type: 'bar', data: ganttData, options: ganttOptions });
        }
        
        // Modal functionality
        const modal = document.getElementById('source-modal');
        const modalTitle = document.getElementById('modal-title');
        const modalText = document.getElementById('modal-text');
        const closeBtn = document.getElementById('modal-close-btn');
        const sourceBtns = document.querySelectorAll('.view-source-btn');

        sourceBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                modalTitle.textContent = btn.dataset.title;
                modalText.textContent = btn.dataset.text;
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            });
        });

        const closeModal = () => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        };

        closeBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });
    });

</script>
</body>
</html>
